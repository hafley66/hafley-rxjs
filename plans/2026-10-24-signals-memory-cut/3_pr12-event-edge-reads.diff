diff --git a/packages/signals/src/2_Signal.events.memory.test.ts b/packages/signals/src/2_Signal.events.memory.test.ts
new file mode 100644
index 00000000..256e725d
--- /dev/null
+++ b/packages/signals/src/2_Signal.events.memory.test.ts
@@ -0,0 +1,36 @@
+import v8 from "node:v8"
+import vm from "node:vm"
+import { expect, test } from "vitest"
+import { Signal } from "./2_Signal.js"
+
+v8.setFlagsFromString("--expose_gc")
+const gc = vm.runInNewContext("gc") as () => void
+const settle = () => { for (let index = 0; index < 4; index++) gc() }
+
+const MEMOS = 2_000
+const EVENTS = 4
+const FIRES = 10
+
+// Retained heap per memo once every memo reads one state signal and EVENTS event signals, after
+// each event fired FIRES times. The edge bookkeeping must stay a few numbers per (memo, event).
+export function measure(): { bytesPerMemo: number } {
+  settle()
+  const before = process.memoryUsage().heapUsed
+  const page = Signal(0)
+  const events = Array.from({ length: EVENTS }, () => Signal<{ n: number }>())
+  const memos = Array.from({ length: MEMOS }, () =>
+    Signal(() => events.reduce((sum, event) => sum + (event.$()?.n ?? 0), page.$())))
+  const subs = memos.map(memo => memo.$.subscribe(() => {}))
+  for (let fire = 0; fire < FIRES; fire++) for (const event of events) event.$({ n: fire })
+  page.$(1)
+  settle()
+  const bytesPerMemo = (process.memoryUsage().heapUsed - before) / MEMOS
+  for (const sub of subs) sub.unsubscribe()
+  return { bytesPerMemo }
+}
+
+test("edge bookkeeping retains a bounded number of bytes per memo", () => {
+  const runs = [measure(), measure(), measure()].map(run => Math.round(run.bytesPerMemo))
+  console.log(JSON.stringify({ bytesPerMemo: runs }))
+  expect(Math.min(...runs)).toBeLessThan(Number(process.env.EDGE_BYTES_PER_MEMO_MAX ?? 13_500))
+})
diff --git a/packages/signals/src/2_Signal.events.test.ts b/packages/signals/src/2_Signal.events.test.ts
new file mode 100644
index 00000000..2ec9b5bf
--- /dev/null
+++ b/packages/signals/src/2_Signal.events.test.ts
@@ -0,0 +1,42 @@
+import { expect, test } from "vitest"
+import { Signal } from "./2_Signal.js"
+
+// An event is an edge: a memo sees it on the run it caused, then reads undefined until the event
+// fires again, equal value or not.
+test("a memo sees each event once, and an event read pushes a rerun", () => {
+  const click = Signal<{ x: number }>()
+  const page = Signal(1)
+  const runs: unknown[] = []
+  const memo = Signal(() => {
+    const seen = { page: page.$(), click: click.$() }
+    runs.push(seen)
+    return seen
+  })
+  const sub = memo.$.subscribe(() => {})
+  click.$({ x: 1 })
+  page.$(2)
+  page.$(3)
+  click.$({ x: 1 })
+  sub.unsubscribe()
+  expect(runs).toEqual([
+    { page: 1, click: undefined },
+    { page: 1, click: { x: 1 } },
+    { page: 2, click: undefined },
+    { page: 3, click: undefined },
+    { page: 3, click: { x: 1 } },
+  ])
+})
+
+test("child paths of one event agree within a run", () => {
+  const drag = Signal<{ x: number; y: number }>()
+  const runs: unknown[] = []
+  const memo = Signal(() => {
+    const seen = { x: drag.x.$(), y: drag.y.$() }
+    runs.push(seen)
+    return seen
+  })
+  const sub = memo.$.subscribe(() => {})
+  drag.$({ x: 3, y: 4 })
+  sub.unsubscribe()
+  expect(runs.at(-1)).toEqual({ x: 3, y: 4 })
+})
