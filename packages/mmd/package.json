{
  "name": "@hafley66/mmd",
  "version": "0.1.0",
  "description": "Mermaid sequence local document, renderer receipt, and SVG binding adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
