  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hafley66/grapht-model": "workspace:*",
    "mermaid": "11.16.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
