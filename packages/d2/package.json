{
  "name": "@hafley66/d2",
  "version": "0.1.0",
  "description": "D2 sequence local document, renderer receipt, and SVG binding adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/6_browser.d.ts",
      "import": "./dist/6_browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@hafley66/grapht-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
