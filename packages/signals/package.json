{
  "name": "@hafley66/signals",
  "version": "0.1.1",
  "description": "RxJS-native reactive signals with proxy-based nested access",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/3_react.d.ts",
      "import": "./dist/3_react.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:jsx-e2e": "vitest --config vitest.jsx-e2e.config.ts",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hafley66/path": "workspace:*",
    "history": "5.3.0",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "rxjs",
    "signals",
    "reactive",
    "state",
    "proxy"
  ],
  "license": "MIT"
}
