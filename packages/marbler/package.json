{
  "name": "@hafley66/marbler",
  "version": "0.0.2",
  "description": "Signal-driven agent message waterfall and timeline panel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && cp src/2_marbler.css dist/2_marbler.css",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "test:browser": "vitest --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@hafley66/grid": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "@tanstack/react-table": "^9.1.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
