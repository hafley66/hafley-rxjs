{
  "name": "@hafley66/md",
  "version": "0.1.2",
  "description": "Sectioned Markdown viewer with folding, navigation, Mermaid, D2, and diagram lightboxes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./plugins/marbles": {
      "types": "./dist/plugins/marbles.d.ts",
      "import": "./dist/plugins/marbles.js"
    },
    "./plugins/echarts": {
      "types": "./dist/plugins/echarts.d.ts",
      "import": "./dist/plugins/echarts.js"
    },
    "./plugins/steps": {
      "types": "./dist/plugins/steps.d.ts",
      "import": "./dist/plugins/steps.js"
    },
    "./plugins/fs-tree": {
      "types": "./dist/plugins/fs-tree.d.ts",
      "import": "./dist/plugins/fs-tree.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vite build && cp src/style.css.d.ts dist/style.css.d.ts",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run test:browser && pnpm run test:e2e && pnpm run build",
    "test:browser": "node ../../scripts/browser-queue.mjs vitest run --config vitest.browser.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hafley66/trace": "workspace:*",
    "@terrastruct/d2": "^0.1.33",
    "d3-dsv": "^3.0.1",
    "file-paths-to-tree": "^4.0.0",
    "lru-cache": "^11.5.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@hafley66/d2": ">=0.1.0",
    "@hafley66/grapht": ">=0.1.0",
    "@hafley66/grapht-model": ">=0.1.0",
    "@hafley66/grapht-render-cytoscape": ">=0.1.0",
    "@hafley66/mmd": ">=0.1.0",
    "@hafley66/signal-grid": ">=0.1.0",
    "@hafley66/signal-marbles": ">=0.0.1",
    "@hafley66/signals": ">=0.1.0",
    "@hafley66/xdom": ">=0.1.0",
    "@streamdown/code": ">=1.1.1",
    "codehike": ">=1.1.0",
    "diff": ">=9.0.0",
    "dockview": ">=6.6.1",
    "echarts": ">=5.5.0",
    "mermaid": ">=11.16.0",
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7",
    "react-resizable-panels": ">=3.0.6 <4",
    "rxjs": ">=7.8.0",
    "streamdown": ">=2.5.0"
  },
  "peerDependenciesMeta": {
    "@hafley66/signal-marbles": {
      "optional": true
    },
    "codehike": {
      "optional": true
    },
    "diff": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hafley66/d2": "workspace:*",
    "@hafley66/grapht": "workspace:*",
    "@hafley66/grapht-model": "workspace:*",
    "@hafley66/grapht-render-cytoscape": "workspace:*",
    "@hafley66/mmd": "workspace:*",
    "@hafley66/signal-grid": "workspace:*",
    "@hafley66/signal-marbles": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "@hafley66/vitest-playwright": "workspace:*",
    "@hafley66/vitest-telemetry": "workspace:*",
    "@hafley66/xdom": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/magic-move": "^4.4.3",
    "@streamdown/code": "^1.1.1",
    "@types/d3-dsv": "^3.0.7",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "codehike": "^1.1.0",
    "diff": "^9.0.0",
    "dockview": "^6.6.1",
    "echarts": "^5.6.0",
    "mermaid": "^11.16.0",
    "playwright": "^1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^3.0.6",
    "rxjs": "^7.8.2",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "d2",
    "react",
    "dockview"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
