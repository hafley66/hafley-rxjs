{
  "name": "@hafley66/md",
  "version": "0.1.2",
  "description": "Sectioned Markdown viewer with folding, navigation, Mermaid, D2, and diagram lightboxes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run test:browser && pnpm run build",
    "test:browser": "node ../../scripts/browser-queue.mjs vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@terrastruct/d2": "^0.1.33"
  },
  "peerDependencies": {
    "@hafley66/d2": ">=0.1.0",
    "@hafley66/grapht": ">=0.1.0",
    "@hafley66/grapht-model": ">=0.1.0",
    "@hafley66/grapht-render-cytoscape": ">=0.1.0",
    "@hafley66/mmd": ">=0.1.0",
    "@hafley66/signals": ">=0.1.0",
    "@streamdown/code": ">=1.1.1",
    "dockview": ">=6.6.1",
    "mermaid": ">=11.16.0",
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7",
    "react-resizable-panels": ">=3.0.6 <4",
    "streamdown": ">=2.5.0"
  },
  "devDependencies": {
    "@hafley66/d2": "workspace:*",
    "@hafley66/grapht": "workspace:*",
    "@hafley66/grapht-model": "workspace:*",
    "@hafley66/grapht-render-cytoscape": "workspace:*",
    "@hafley66/mmd": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "@streamdown/code": "^1.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "dockview": "^6.6.1",
    "jsdom": "26.1.0",
    "mermaid": "^11.16.0",
    "playwright": "^1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^3.0.6",
    "streamdown": "^2.5.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "d2",
    "react",
    "dockview"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
