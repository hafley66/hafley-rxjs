{
  "name": "@hafley66/bewpp",
  "version": "0.0.1",
  "description": "browser controls over a local extension worker and content-script message bridge",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": "./src/3_build.mjs",
    "./pairing": "./src/0_pairing.mjs",
    "./dom": "./src/extension/1_dom.ts"
  },
  "files": [
    "dist",
    "src",
    "0_build.mjs",
    "tsconfig*.json",
    "README.md"
  ],
  "scripts": {
    "build": "node 0_build.mjs && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "node --test tests/*.test.mjs",
    "probe:main-world-hook": "node probes/main-world-hook.mjs",
    "receipts": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@aklinker1/zero-serialize-error": "1.0.2",
    "@fastify/websocket": "11.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.7",
    "@webext-core/messaging": "4.0.0",
    "async-mutex": "0.5.0",
    "birpc": "4.2.0",
    "rolldown": "1.2.7",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "fastify": "5.12.3",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "browser",
    "chrome-extension",
    "manifest-v3",
    "dom",
    "automation",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hafley66/hafley-rxjs",
    "directory": "packages/bewpp"
  }
}
