exports[`Bash scaffold > creates typed kit pages, all field kinds, copies and compositions without editing source generators 1`] = `
"import { type AnySpec, type ValuesOf } from "@hafley66/report-shell"
import type { Algo, AlgoCtx, AlgoOut } from "../kit/2_algo.js"
import { circle } from "../lib/1_geom.js"

export const SPEC = {
  radius: { kind: "range", hint: "radius as a fraction of the cell size", min: 0.1, max: 0.45, step: 0.01, default: 0.35 },
  field_range: { kind: "range", hint: "field_range", min: 0, max: 100, step: 1, default: 50 },
  field_number: { kind: "number", hint: "field_number", min: 0, max: 100, step: 1, default: 0 },
  field_seed: { kind: "seed", hint: "field_seed", default: 1 },
  field_select: { kind: "select", hint: "field_select", options: ["a", "b"], default: "a" },
  field_bool: { kind: "bool", hint: "field_bool", default: true },
  field_text: { kind: "text", hint: "field_text", default: "", pool: ["alpha", "beta", "gamma"] },
  // scaffold:inputs
} as const satisfies AnySpec
export type Params = ValuesOf<typeof SPEC>

export function generate(p: Params, ctx: AlgoCtx): AlgoOut {
  // Replace this body with the generator. Inputs arrive in p; return paths in cell coordinates.
  return { paths: [{ d: circle(0, 0, ctx.size * p.radius), z: 0 }], caption: "scaffold_receipt", lod: [] }
}

export const ALGO: Algo<Params> = {
  name: "scaffold_receipt",
  spec: SPEC,
  presets: {},
  run: generate,
}
"
`;

