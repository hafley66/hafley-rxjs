      <AlgoSection page="scaffold_receipt" algo={section_packing} sizes={SIZES} />
      <AlgoSection page="scaffold_receipt" algo={section_variant} sizes={SIZES} />
      {/* scaffold:sections */}
    </>
  )
}

export const PAGE: PageSpec = {
  id: "scaffold_receipt",
  title: "gothic: scaffold_receipt",
