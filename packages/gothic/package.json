{
  "name": "@hafley66/gothic",
  "version": "0.0.0",
  "private": true,
  "description": "Procedural SVG notebooks as one React SPA: spec-derived bars, URL state per section, shuffle, draw-in, algo contract",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build:single && pnpm test:e2e",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hafley66/path": "workspace:*",
    "@hafley66/report-shell": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "@thi.ng/colored-noise": "1.0.138",
    "@thi.ng/random": "4.1.54",
    "animejs": "4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^4.1.10"
  }
}
