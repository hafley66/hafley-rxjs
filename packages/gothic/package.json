    "d3-contour": "4.0.2",
    "d3-delaunay": "6.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "svg-path-properties": "2.1.0",
    "svgpath": "2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
