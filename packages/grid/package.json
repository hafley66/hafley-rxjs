{
  "name": "@hafley66/grid",
  "version": "0.1.6",
  "description": "Signal-driven TanStack v9 grid for hafley-rxjs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/3_react.d.ts",
      "import": "./dist/3_react.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:browser": "vitest --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@hafley66/path": "^0.1.0",
    "@hafley66/signals": "^0.1.0",
    "@tanstack/react-table": "^9.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "devalue": "^5.9.0",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "rxjs",
    "signals",
    "tanstack",
    "table",
    "grid",
    "reactive"
  ],
  "license": "MIT"
}
