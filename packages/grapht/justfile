# grapht protocol-lane recipes. Composes executable adapters only; never imports
# their implementations. Renderer recipes (compare-layouts, cytoscape, canvaskit,
# matrix) arrive with their lanes (4, 5, 5a).

set shell := ["bash", "-uc"]
set export := true
export PATH := justfile_directory() + "/bin:" + env("PATH")

default: build

build:
    pnpm run build

# render browser evidence headlessly and write validated PNG receipts
renderer-screenshots:
    pnpm --dir adapters/4_render_sigma run benchmark:screenshots

# visibly drive Chromium; headed mode occurs only through this explicit recipe
renderer-headed:
    GRAPHT_BREAKPOINT_HEADED=1 pnpm --dir adapters/4_render_sigma run benchmark:breakpoints

# run the deterministic core scenario contract tests
scenario-tests:
    pnpm run build
    pnpm exec vitest run tests/1_scenarios.test.ts

# run the Cytoscape scenario browser lane against the shared 1k JSON fixture
scenario-cytoscape:
    node scripts/0_generate_renderer_fixture.mjs 1000
    pnpm --dir adapters/2_render_cytoscape run lab

# run the Sigma scenario browser lane against the shared 1k JSON fixture
scenario-sigma:
    node scripts/0_generate_renderer_fixture.mjs 1000
    pnpm --dir adapters/4_render_sigma run lab -- e2e/1_scenarios.spec.ts

# run the PixiJS unit tests and typecheck
test-pixijs:
    pnpm --dir adapters/6_render_pixijs run check

# run the PixiJS browser scenario lane (WebGL + WebGPU, retained + particles)
# headless by default; writes PNG + JSON receipts into the lane
browser-pixijs:
    node scripts/0_generate_renderer_fixture.mjs 1000
    node scripts/0_generate_renderer_fixture.mjs 5000
    node scripts/0_generate_renderer_fixture.mjs 10000
    pnpm --dir adapters/6_render_pixijs run test:e2e

# record a PixiJS shell-protocol receipt through the grapht-bench/0 adapter
receipt-pixijs:
    pnpm --dir adapters/6_render_pixijs run receipt

# visibly drive Chromium through the PixiJS lane; headed only through this recipe
headed-pixijs:
    pnpm --dir adapters/6_render_pixijs exec playwright test --headed

# run the Three.js unit tests and typecheck
test-threejs:
    pnpm --dir adapters/7_render_threejs run check

# run the Three.js browser scenario lane (WebGL + WebGPU, retained + particles)
# headless by default; writes PNG + JSON receipts into the lane
browser-threejs:
    node scripts/0_generate_renderer_fixture.mjs 1000
    node scripts/0_generate_renderer_fixture.mjs 5000
    node scripts/0_generate_renderer_fixture.mjs 10000
    pnpm --dir adapters/7_render_threejs run test:e2e

# record a Three.js shell-protocol receipt through the grapht-bench/0 adapter
receipt-threejs:
    pnpm --dir adapters/7_render_threejs run receipt

# visibly drive Chromium through the Three.js lane; headed only through this recipe
headed-threejs:
    pnpm --dir adapters/7_render_threejs exec playwright test --headed

# list the checked-in fixtures with node/edge counts
fixtures: build
    @grapht-fixtures list

# run one adapter against one fixture through the shell protocol
bench fixture adapter: build
    @grapht-fixtures emit {{fixture}} | grapht-bench run --adapter {{adapter}}

# record a completed JSONL stream into a run directory
record input output="runs/recorded": build
    @mkdir -p {{output}}
    @grapht-bench record --output {{output}} < {{input}}

# tail a live JSONL stream into a run directory
tail input output="runs/tailed": build
    @mkdir -p {{output}}
    @tail -F {{input}} | grapht-bench record --output {{output}}
