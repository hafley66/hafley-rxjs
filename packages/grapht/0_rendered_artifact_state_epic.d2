      - `anim/REPORT-D2ANIM-A.md`
      - `hafley-rxjs/packages/react-dock-and-flow/README.md`
    |
    shape: document
  }
  history: {
    label: |md
      ### Historical seams

      - `anim/atlas/DESIGN.md`
      - `anim/atlas/CORE-README.md`
      - `anim/DESIGN.md`
      - `sprefa/plans/2026-06-06-graph-viz-atlas.md`
      - `sprefa/plans/2026-05-18-pr-causal-map-animation.md`
      - `anim/chat_log/20260612.0.sprefa-anim-deck-d2-file-shim.md`
      - `anim/chat_log/20260614.0.anim-atlas-fold-and-sprefa-open-tasks.md`

      Plans mention `sprefa/REPORT-D2ANIM-B.md`, which is absent. Its findings appear in
      `sprefa/plans/2026-08-08-d2-svg-cytoscape-report.md`.
    |
    shape: document
  }
}

timeline: {
  label: "Example revision timeline"
  r0: { label: "R0\nparse -> render -> extract -> project"; shape: hexagon }
  r1: { label: "R1\nsource diff + keyed entity diff"; shape: hexagon }
  r2: { label: "R2\nhuman moves projected nodes"; shape: hexagon }
  r3: { label: "R3\nAI requests entity-specific patch"; shape: hexagon }
  r4: { label: "R4\nnew source revision reconciles placement"; shape: hexagon }
  r0 -> r1 -> r2 -> r3 -> r4
}

delivery: {
  label: "Epic slices"
  s0: { label: "0_fixture\nGit D2 revisions + expected entity diffs" }
  s1: { label: "1_capture\nartifact/revision/entity IDs + fence cache" }
  s2: { label: "2_d2\nparse + render + SVG ID/geometry extraction" }
  s3: { label: "3_projection\nnormalized model -> Cytoscape/XYFlow" }
  s4: { label: "4_transition\nkeep/enter/exit/update + geometry interpolation" }
  s5: { label: "5_placement\nseparate human layout journal" }
  s6: { label: "6_markdown\nAST structural index + graph projection" }
  s7: { label: "7_override\nmessage-carried patches and authority rules" }
  s0 -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7
}

goal -> inputs.git
goal -> inputs.scrape
goal -> inputs.markdown
inputs.git -> capture.revision
inputs.scrape -> capture.revision
inputs.markdown -> capture.revision
inputs.override_example -> model.journal: "future event"
capture.revision -> capture.artifact
capture.artifact -> capture.address
capture.address -> parse.d2
capture.address -> parse.mermaid
capture.address -> parse.md_ast
parse.d2 -> model.entity
parse.mermaid -> model.entity
parse.md_ast -> model.entity
model.entity -> model.topology
model.topology -> model.journal
model.placement -> model.journal
model.topology -> render.language
render.language -> render.svg
render.svg -> render.geometry
render.geometry -> render.projection
model.topology -> render.projection
model.placement -> render.projection
model.journal -> diff.keyed
diff.keyed -> diff.node_motion
diff.keyed -> diff.path_motion
diff.keyed -> diff.enter_origin
diff.debounce -> render.language: "schedule/cancel"
geometry_tools.browser -> render.geometry
geometry_tools.svg_libs -> diff.path_motion
geometry_tools.graph_layout -> render.projection
geometry_tools.spatial -> model.placement
repositories.sprefa -> model.topology: "facts + IDs"
repositories.anim -> diff.keyed: "transition contract"
repositories.rxjs -> render.projection: "reusable UI package"
repositories.instant -> model.journal: "host + persistence"
documents.recent -> goal
documents.history -> repositories.anim
timeline -> delivery
