{
  "name": "@hafley66/grapht-render-sigma",
  "version": "0.1.0",
  "description": "Sigma projection adapter for grapht-bench/0: WebGL graph import, render, camera interaction, picking, disposal receipt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "fixtures": "node --import tsx scripts/generate-fixtures.ts",
    "bench": "node --import tsx src/3_protocol_adapter.ts",
    "receipt": "printf '%s\\n' '{\"protocol\":\"grapht-bench/0\",\"runId\":\"sigma-receipt\",\"fixture\":\"grid-1k\",\"operation\":\"render\",\"outputDirectory\":\"receipts/generated\",\"parameters\":{}}' | node --import tsx src/3_protocol_adapter.ts",
    "benchmark:breakpoints": "node 6_renderer_breakpoints.mjs",
    "demo:breakpoints": "GRAPHT_BREAKPOINT_SCREENSHOTS=1 node 6_renderer_breakpoints.mjs",
    "lab": "node ../../scripts/0_generate_renderer_fixture.mjs 1000 && node ../../scripts/0_generate_renderer_fixture.mjs 5000 && node ../../scripts/0_generate_renderer_fixture.mjs 10000 && playwright test -c playwright.config.ts",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.8",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
