{
  "name": "@hafley66/grapht-render-threejs",
  "version": "0.1.0",
  "description": "Three.js projection adapter for grapht-bench/0: WebGL and WebGPU graph import, render, camera interaction, picking, disposal receipt",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:e2e": "node ../../scripts/0_generate_renderer_fixture.mjs 1000 && node ../../scripts/0_generate_renderer_fixture.mjs 5000 && node ../../scripts/0_generate_renderer_fixture.mjs 10000 && playwright test -c playwright.config.ts",
    "bench": "node --import tsx src/3_protocol_adapter.ts",
    "receipt": "printf '%s\\n' '{\"protocol\":\"grapht-bench/0\",\"runId\":\"threejs-receipt\",\"fixture\":\"grid-1k\",\"operation\":\"render\",\"outputDirectory\":\"receipts/generated\",\"parameters\":{\"renderer\":\"webgl\",\"representation\":\"retained\"}}' | node --import tsx src/3_protocol_adapter.ts",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@hafley66/grapht": "workspace:^",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.8",
    "@types/three": "^0.185.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
