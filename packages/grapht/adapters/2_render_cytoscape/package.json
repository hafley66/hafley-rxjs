{
  "name": "@hafley66/grapht-render-cytoscape",
  "version": "0.1.0",
  "description": "Cytoscape projection adapter for the grapht-bench/0 protocol: loads external grapht-geometry/0 positions, projects through Cytoscape preset layout, exercises pan/zoom/select/readback/disposal, and emits JSONL samples, screenshot, trace, and correctness receipt",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./benchmark": "./4_adapter.ts"
  },
  "bin": {
    "render-cytoscape": "./bin/grapht-adapter-render-cytoscape.ts"
  },
  "files": [
    "dist",
    "bin",
    "index.html",
    "3_style.css",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && vitest run",
    "proof:svg": "d2 --watch=false --theme=0 --layout=dagre --pad=100 --scale=1 ../../0_rendered_artifact_state_epic.d2 proof/arch.svg",
    "test:browser": "pnpm run proof:svg && node ../../../../scripts/browser-queue.mjs vitest run --config vitest.browser.config.ts",
    "lab": "node ../../scripts/0_generate_renderer_fixture.mjs 1000 && playwright test -c playwright.config.ts",
    "receipt": "node --experimental-strip-types bin/grapht-adapter-render-cytoscape.ts",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run test:browser"
  },
  "dependencies": {
    "@hafley66/grapht": "workspace:^",
    "cytoscape": "^3.31.1",
    "dompurify": "3.4.14",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@types/node": "^25.0.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "vite": "^8.2.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
