{
  "name": "@hafley66/grapht-render-cytoscape",
  "version": "0.1.0",
  "description": "Cytoscape projection adapter for the grapht-bench/0 protocol: loads external grapht-geometry/0 positions, projects through Cytoscape preset layout, exercises pan/zoom/select/readback/disposal, and emits JSONL samples, screenshot, trace, and correctness receipt",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./benchmark": {
      "types": "./dist/4_adapter.d.ts",
      "import": "./dist/4_adapter.js"
    }
  },
  "bin": {
    "render-cytoscape": "./dist/bin/grapht-adapter-render-cytoscape.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc --noEmit -p tsconfig.json",
    "build:app": "vite build --config vite.config.ts",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run test:browser",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "test:proof": "node proof/cytoProbe.mjs",
    "proof:live": "pnpm run proof:svg && vite --config proof/vite.config.ts",
    "proof:svg": "d2 --watch=false --theme=0 --layout=dagre --pad=100 --scale=1 ../../0_rendered_artifact_state_epic.d2 proof/arch.svg",
    "test:browser": "pnpm run proof:svg && node ../../../../scripts/browser-queue.mjs vitest run --config vitest.browser.config.ts",
    "lab": "node ../../scripts/0_generate_renderer_fixture.mjs 1000 && playwright test -c playwright.config.ts",
    "receipt": "node --experimental-strip-types bin/grapht-adapter-render-cytoscape.ts"
  },
  "dependencies": {
    "@hafley66/grapht": "workspace:^",
    "@hafley66/grapht-model": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "cytoscape": "^3.31.1",
    "dompurify": "3.4.14",
    "playwright": "^1.62.1",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hafley66/trace": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@types/node": "^25.0.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
