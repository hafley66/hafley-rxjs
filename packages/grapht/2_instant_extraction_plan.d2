direction: right

title: |md
  # Instant extraction plan

  Move reusable graph, trace, Markdown, and live-probe mechanics from Instant into
  `@hafley66/grapht`. Instant remains a host adapter and fixture application.
|

network: {
  label: "0. Session network and trace viewer"

  current: {
    label: |md
      ## Current Instant seams

      - `src/plugins/harnessTrace/InTabStrip.tsx` selects table or network mode.
      - `src/plugins/harnessTrace/4_Waterfall.tsx` renders the network-style timeline.
      - `src/plugins/harnessTrace/0_types.ts` defines session, parent, strip, and waterfall rows.
      - `src/plugins/harnessTrace/0_tree.ts` resolves subagent and dispatch ancestry.
      - `src/plugins/harnessTrace/0_strip.ts` selects the terminal-local session tree.
      - `src/plugins/harnessTrace/2_join.ts` joins sessions, mail legs, and terminal ownership.
      - `e2e/waterfall.spec.ts` verifies table/network parity and active/history scopes.
      - `e2e/harness-trace.spec.ts` verifies nested subagent and dispatch relationships.
    |
    shape: document
  }

  model: {
    label: ||md
      ```ts
      export interface NetworkDocument<Row, Event> {
        rows: readonly Row[]
        graph: ProjectionGraph
        trace: readonly Event[]
        clock: TraceClock
      }

      export interface NetworkViewState {
        mode: "grid" | "graph" | "waterfall" | "sequence"
        scope: "active" | "history" | "all"
        selected: EntityId[]
        expanded: EntityId[]
        camera?: Camera
      }

      export interface NetworkProjection<Row, Event> {
        grid(input: NetworkDocument<Row, Event>): GridProjection<Row>
        graph(input: NetworkDocument<Row, Event>): ProjectionGraph
        waterfall(input: NetworkDocument<Row, Event>): WaterfallProjection
        sequence(input: NetworkDocument<Row, Event>, density: SequenceDensity): SequenceModel
        marble(input: NetworkDocument<Row, Event>, event: Event): TraceRoute
      }
      ```
    ||
    shape: document
  }

  grid: {
    label: |md
      ## Canonical row view

      Network entities and trace events use `@hafley66/grid`. The grid owns sorting,
      filtering, expansion, selection, virtualization, and keyboard navigation. Graph,
      waterfall, and sequence views consume the same selected row set and stable entity IDs.
      Switching projection does not rebuild the underlying session/trace model.
    |
    shape: document
  }

  capabilities: {
    label: |md
      ## Existing dependency capabilities to record

      - `@hafley66/grid`: row projection and virtualization.
      - Cytoscape: mutable graph projection, compound nodes, layouts, animation, selection.
      - XYFlow: React node projection, measured rectangles, custom nodes and edges, viewport.
      - D2: authored graph/sequence source and SVG geometry carrier.
      - Browser SVG APIs: transforms, bounds, path length, and sampled points.
      - RxJS/signals: trace clock, active projection, selection, and derived row state.

      The extraction lane records dependency, API, data-shape, and runtime costs without a
      qualitative build-versus-buy verdict.
    |
    shape: document
  }
}

rxjs_devtool: {
  label: "Future consumer: RxJS debugger and devtool"

  model: {
    label: ||md
      ```ts
      export interface ReactiveNetworkDocument extends NetworkDocument<ReactiveRow, ReactiveEvent> {
        observables: ObservableEntity[]
        subscriptions: SubscriptionEntity[]
        operators: OperatorEntity[]
        schedulers: SchedulerEntity[]
      }

      export type ReactiveEvent =
        | { type: "subscribe"; subscription: EntityId; at: number }
        | { type: "next"; subscription: EntityId; value: unknown; at: number }
        | { type: "error"; subscription: EntityId; error: unknown; at: number }
        | { type: "complete"; subscription: EntityId; at: number }
        | { type: "unsubscribe"; subscription: EntityId; at: number }
        | { type: "schedule"; scheduler: EntityId; task: EntityId; at: number }
      ```
    ||
    shape: document
  }

  projections: {
    label: |md
      The same network document and stable entity IDs later project RxJS runtime data as:

      - canonical grid rows for observables, subscriptions, operators, and events;
      - operator/subscription topology in Cytoscape or XYFlow;
      - subscription lifetimes and emissions in the waterfall;
      - compact sequence diagrams for subscribe/next/error/complete/unsubscribe ordering;
      - marble traces moving through operator and subscription edges;
      - D2 snapshots for saved, diffable debugger states.

      RxJS instrumentation and debugger capture remain outside the initial Instant extraction.
      `grapht` supplies the network, trace, geometry, revision, and projection vocabulary.
    |
    shape: document
  }

  context: {
    label: |md
      Existing adjacent plans:

      - `packages/devtool-plugin/PLAN-2026-07-25-debugger-core.md`
      - `packages/devtool-plugin/PLAN-2026-07-25-live-visualizer.md`
      - `packages/devtool-plugin/PLAN-2026-07-26-debugger-core-v2.md`
    |
    shape: document
  }
}

session_workspace: {
  label: "Target Instant screen: tmux plus evolving session graph"

  layout: {
    label: ||md
      ```ts
      export interface SessionWorkspacePanel {
        terminal: TmuxSessionView
        graph: SessionGraphView
        timeline: RevisionTimeline
        selection: SessionSelection
      }

      export interface SessionSelection {
        entity?: EntityId
        terminalRange?: TerminalRange
        revision?: RevisionId
      }
      ```

      The normal interactive tmux terminal occupies the primary dock region. A graph panel on
      the right displays a reduced representation of that same session. Selection is linked in
      both directions: terminal ranges select graph entities, and graph entities reveal their
      terminal evidence. A revision scrubber can inspect prior graph states without detaching
      the live tmux session.
    ||
    shape: document
  }

  reduction: {
    label: ||md
      ```ts
      export type SessionGraphEntity =
        | TerminalCommandEntity
        | ProcessEntity
        | AgentEntity
        | ToolCallEntity
        | FileEntity
        | ArtifactEntity
        | MessageEntity

      export interface SessionGraphRevision {
        session: SessionId
        revision: RevisionId
        capturedAt: number
        terminalRange: TerminalRange
        entities: readonly SessionGraphEntity[]
        relations: readonly SessionGraphRelation[]
      }

      export interface SessionGraphReducer {
        append(events: readonly TerminalEvent[], previous?: SessionGraphRevision):
          SessionGraphRevision
      }
      ```

      Tmux output and bounded scrollback enter an incremental scanner. Recognized commands,
      messages, files, agents, tool calls, processes, and artifacts become stable entities with
      evidence spans. Each debounced append produces a revision, structural diff, retained
      placement input, and transition plan for the graph panel.
    ||
    shape: document
  }

  projections: {
    label: |md
      The right panel can switch among network graph, compact sequence, marble trace,
      agent/tool waterfall, grid, and saved D2 projections over the same session revisions.

      Instant owns tmux capture and dock composition. `sprefa-extract` supplies recognized
      spans and relations. `grapht` owns stable identities, revisions, diffs, placements,
      transition plans, selection, and projections.
    |
    shape: document
  }
}

markdown: {
  label: "1. Markdown document viewer"

  current: {
    label: |md
      ## Current Instant seams

      - `src/mdview/model.ts` is the pure section parser and source-slice model.
      - `src/mdview/ports.ts` is the existing host boundary.
      - `src/mdview/signals.ts` owns document cache and per-path state.
      - `src/mdview/MdPanel.tsx` renders the document panel.
      - `src/mdview/MdExplorer.tsx` renders Markdown file navigation.
      - `src/mdview/d2.ts` renders D2 fences.
      - `src/mdview/0_DiagramLightbox.tsx` opens rendered diagrams.
      - `src/0_markdownTree.ts` adapts parsed headings into the canonical tree grid.
      - `src/main.ts` installs the host and registers the panel.
      - `e2e/mdzoom.spec.ts` covers zoom, links, and code-block behavior.
    |
    shape: document
  }

  model: {
    label: ||md
      ```ts
      export interface MarkdownDocument {
        artifact: ArtifactRevision
        graph: EntityGraph
        sections: MarkdownSection[]
        links: ResolvedLink[]
        diagrams: EmbeddedDiagram[]
        diagnostics: Diagnostic[]
      }

      export interface MarkdownSection {
        id: EntityId
        depth: number
        title: string
        span: SourceSpan
        children: EntityId[]
      }

      export interface EmbeddedDiagram {
        id: EntityId
        language: "d2" | "mermaid"
        source: SourceSpan
        artifactId: ArtifactId
        revisionId: RevisionId
      }

      export interface MarkdownHost {
        read(source: SourceRef): Promise<string>
        watch(source: SourceRef): AsyncIterable<ArtifactRevision>
        open(target: ResolvedLink): void
        reveal(span: SourceSpan): void
      }
      ```
    ||
    shape: document
  }

  boundary: {
    label: |md
      ## Package split

      `grapht` owns Markdown parsing, section identity, source spans, links, embedded diagram
      capture, revision diffs, and framework-free document state. A React adapter may own the
      first rendered document component. Instant owns filesystem access, Dockview panel
      registration, native open/reveal behavior, persisted host preferences, and application
      styling.
    |
    shape: document
  }
}

probe: {
  label: "2. Whole-app live probe"

  model: {
    label: ||md
      ```ts
      export type ProbeEvent =
        | { type: "react.render"; component: string; instance: string; at: number }
        | { type: "dom.sample"; root: string; nodes: number; at: number }
        | { type: "artifact.parse"; revisionId: RevisionId; durationMs: number; entities: number }
        | { type: "diagram.render"; revisionId: RevisionId; durationMs: number; svgNodes: number }
        | { type: "projection.update"; viewId: ViewId; durationMs: number; changed: number }
        | { type: "trace.frame"; traceId: TraceId; time: number; active: number }

      export interface ProbeLog {
        append(event: ProbeEvent): void
        read(query?: ProbeQuery): readonly ProbeEvent[]
        subscribe(listener: (events: readonly ProbeEvent[]) => void): () => void
      }

      export interface ProbeDisplayState {
        domNodes: number
        rendersByComponent: ReadonlyMap<string, number>
        latestDurations: ReadonlyMap<ProbeEvent["type"], number>
        recent: readonly ProbeEvent[]
      }
      ```
    ||
    shape: document
  }

  placement: {
    label: |md
      ## Initial display

      Mount a collapsible debugger strip at the bottom of the media viewer. Count DOM nodes
      within the active tab or explicit probe root. Count committed component renders by
      stable component/instance identity. The display reads a structured in-memory log and
      excludes its own rendering from observed component totals. The same display later
      mounts in Markdown, network, graph, and sequence viewers.
    |
    shape: document
  }
}

sequence: {
  label: "3. Extraction order"
  s0: { label: "0_live probe\nland in Instant, retain reusable boundary" }
  s1: { label: "1_markdown model\npure parser + sections + links + spans" }
  s2: { label: "2_diagram embeds\nD2/Mermaid revisions + geometry" }
  s3: { label: "3_network model\nsessions + relations + trace events" }
  s4: { label: "4_grid projection\ncanonical rows over network model" }
  s5: { label: "5_graph projections\nD2/SVG/Cytoscape/XYFlow" }
  s6: { label: "6_compact sequence\nfolds + density + summaries" }
  s7: { label: "7_marble playback\ntrace clock + route geometry" }
  s8: { label: "8_instant adapters\nfilesystem + Dockview + native host" }
  s0 -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8
}

