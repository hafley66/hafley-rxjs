{
  "name": "@hafley66/grapht",
  "version": "0.1.0",
  "description": "Implementation-agnostic graph benchmark protocol (grapht-bench/0): fixtures, shell harness, collector, and identity adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/4_board/react/index.d.ts",
      "import": "./dist/react.js"
    }
  },
  "bin": {
    "grapht-bench": "./bin/grapht-bench",
    "grapht-fixtures": "./bin/grapht-fixtures",
    "grapht-adapter-identity": "./bin/grapht-adapter-identity",
    "grapht-history": "./bin/grapht-history",
    "grapht-doc-history": "./bin/grapht-doc-history"
  },
  "files": [
    "dist",
    "bin",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "pnpm run build && vitest run tests",
    "typecheck": "tsc --noEmit",
    "receipts": "pnpm run typecheck && pnpm run test",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "test:browser": "node ../../scripts/browser-queue.mjs vitest run -c vitest.browser.config.ts",
    "renderer-fixture": "node scripts/0_generate_renderer_fixture.mjs",
    "fixture:sequence": "node scripts/3_generate_sequence_fixture.mjs",
    "smoke:board": "node scripts/7_boardSmoke.mjs",
    "bench:fixture-memory": "node scripts/2_compare_fixture_memory.mjs",
    "api": "node scripts/4_api.mjs",
    "docs": "node scripts/5_docs.mjs",
    "docs:render": "pnpm run plans && pnpm run api && node scripts/5_docs.mjs && node scripts/5_docs.mjs --render",
    "site:content": "pnpm run docs:render && rm -rf site/pages && mkdir site/pages && cp docs/dist/*.md site/pages/",
    "site": "pnpm run site:content && vitepress dev site",
    "site:build": "pnpm run site:content && vitepress build site",
    "site:preview": "vitepress preview site",
    "ship": "node scripts/ship.mjs",
    "plans": "node scripts/6_plans.mjs",
    "test:site": "node ../../scripts/browser-queue.mjs vitest run -c vitest.site.config.ts"
  },
  "dependencies": {
    "@hafley66/grapht-model": "workspace:*",
    "@hafley66/scene": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "cytoscape": "3.34.0",
    "cytoscape-fcose": "2.2.0",
    "graphology": "0.26.0",
    "rxjs": "^7.8.2",
    "string-argv": "0.3.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hafley66/docs-kit": "workspace:*",
    "@hafley66/path": "workspace:*",
    "@hafley66/vitest-playwright": "workspace:*",
    "@hafley66/vitest-telemetry": "workspace:*",
    "@types/node": "^25.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
