{
  "name": "@hafley66/react-dock-and-flow",
  "version": "0.0.3",
  "description": "Dockview and React Flow workspace driven by RxJS and Hafley signals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
   "types": "./dist/style.css.d.ts",
   "default": "./dist/style.css"
  }
  },
  "scripts": {
    "build": "vite build && cp src/style.css.d.ts dist/style.css.d.ts",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "check": "pnpm run receipts",
    "test:perf": "playwright test -c e2e/0_perfLab.config.ts",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hafley66/signals": "workspace:*"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12.0.0",
    "cytoscape": ">=3.33.0",
    "dockview": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "rxjs": ">=7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@hafley66/rxjs-ext": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xyflow/react": "^12.11.2",
    "cytoscape": "^3.33.1",
    "dockview": "^6.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "dockview",
    "react-flow",
    "rxjs",
    "signals"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
