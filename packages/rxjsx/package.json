{
  "name": "@hafley66/rxjsx",
  "version": "0.0.1",
  "description": "Observable-based JSX runtime using Snabbdom virtual DOM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hafley66/rxjs-ext": "workspace:*",
    "snabbdom": "^3.6.2"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "vite": "^8.2.1",
    "jsdom": "^26.1.0"
  },
  "keywords": [
    "rxjs",
    "jsx",
    "reactive",
    "snabbdom",
    "vdom"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
