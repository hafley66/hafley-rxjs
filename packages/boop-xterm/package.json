{
  "name": "@hafley66/boop-xterm",
  "version": "0.0.1",
  "description": "Pure terminal geometry, token, and turn matching helpers for boop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
