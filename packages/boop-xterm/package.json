{
  "name": "@hafley66/boop-xterm",
  "version": "0.0.1",
  "description": "Terminal geometry, reactive overlays, and pane models for boop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "types": "./dist/theme.css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "vite build && cp src/theme.css src/theme.css.d.ts dist/",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0",
    "@hafley66/signals": ">=0.1.0",
    "rxjs": ">=7.8.0",
    "@hafley66/md": ">=0.1.2",
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "@hafley66/signals": "workspace:*",
    "rxjs": "^7.8.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "^1.62.1",
    "@hafley66/md": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
