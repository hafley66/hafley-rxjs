  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
