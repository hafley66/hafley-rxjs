{
  "name": "@hafley66/trace",
  "version": "0.1.0",
  "description": "One identity and scheduling-lag model for node, browsers and workers, printed to OpenTelemetry resource attributes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "receipts": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "telemetry",
    "opentelemetry",
    "logging",
    "tracing",
    "performance"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
