{
  "name": "@hafley66/signal-grid",
  "version": "0.1.0",
  "description": "Relational data grid kernel: two ordered forests, five pure operators, RxJS intents, signal derivation. MUI X feature parity without a table library.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "vite build && cp src/theme.css dist/",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "parity": "node scripts/parity.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:render": "node scripts/docs.mjs --render",
    "docs:fix": "node scripts/docs.mjs --fix",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "size": "size-limit",
    "treemap": "SIGNAL_GRID_TREEMAP=1 vite build",
    "receipts": "pnpm typecheck && pnpm test && pnpm test:browser && pnpm build && pnpm size && pnpm docs",
    "test:visual": "vitest run -c vitest.visual.config.ts",
    "videos": "node scripts/videos.mjs",
    "demo": "vite -c demo/vite.config.ts",
    "demo:build": "vite build -c demo/vite.config.ts",
    "demo:preview": "vite preview -c demo/vite.config.ts",
    "bench": "vitest bench -c bench/vitest.bench.config.ts",
    "typecheck:bench": "tsc --noEmit -p bench/tsconfig.json",
    "site": "pnpm site:content && vitepress dev site",
    "site:dev": "pnpm site",
    "site:content": "node scripts/docs.mjs --render && rm -rf site/pages && mkdir site/pages && cp docs/dist/*.md site/pages/ && cp bench/README.md site/benchmarks.md && cp demo/README.md site/demo-guide.md",
    "site:build": "pnpm site:content && vitepress build site",
    "site:preview": "vitepress preview site",
    "examples": "node scripts/examples.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "peerDependencies": {
    "@hafley66/path": ">=0.1.0",
    "@hafley66/signals": ">=0.1.0",
    "@hafley66/xdom": ">=0.1.0",
    "@logtape/logtape": "^2.3.3",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@logtape/logtape": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@hafley66/path": "workspace:*",
    "@hafley66/signals": "workspace:*",
    "@hafley66/vitest-playwright": "workspace:*",
    "@hafley66/vitest-telemetry": "workspace:*",
    "@hafley66/xdom": "workspace:*",
    "@logtape/logtape": "2.3.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@size-limit/time": "^13.0.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/table-core": "9.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "codemirror": "^6.0.2",
    "mermaid": "^11.16.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "rxjs": "^7.8.2",
    "size-limit": "^13.0.3",
    "sucrase": "^3.35.1",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10",
    "vue": "^3.5.42"
  },
  "keywords": [
    "grid",
    "table",
    "rxjs",
    "signals",
    "relational",
    "virtualization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
