{
  "name": "@hafley66/rxjs-ext",
  "version": "0.0.1",
  "description": "RxJS operator extensions - switchMapCached, repeatValue, and more",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm --workspace-root exec node scripts/0_prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "files": ["dist"],
  "dependencies": {
    "debug": "^4.4.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@types/debug": "^4.1.12"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.10",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "rxjs",
    "operators",
    "cache",
    "reactive"
  ],
  "license": "MIT"
}
