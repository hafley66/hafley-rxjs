sequenceDiagram
  participant alice as Alice
  participant bob as Bob
  participant archive as Archive Service Far Right
  alice->>archive: preface
  loop outer exchange
    alt nested review
      alice->>bob: repeat
      activate bob
      bob->>bob: inspect
      Note right of bob: local note
      alice->>bob: repeat
      deactivate bob
    end
  end
  bob->>archive: archive
