{
  "name": "hafley-rxjs",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "check:json-rx": "pnpm --filter @hafley66/json-rx check",
    "generate": "pnpm --filter @hafley66/json-rx generate",
    "generate:check": "pnpm --filter @hafley66/json-rx generate:check",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r test -- --watch",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.10",
    "typedoc": "^0.28.15",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "@typescript/typescript6": "6.0.2"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.11"
  }
}
