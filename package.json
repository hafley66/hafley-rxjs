{
  "name": "hafley-rxjs",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:json-rx": "pnpm --filter @hafley66/json-rx check",
    "generate": "pnpm --filter @hafley66/json-rx generate",
    "generate:check": "pnpm --filter @hafley66/json-rx generate:check",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r test -- --watch",
    "docs": "typedoc",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:check": "node scripts/1_releaseCheck.mjs --structure-only",
    "release:audit": "node scripts/1_releaseCheck.mjs",
    "release:publish": "pnpm release:check && changeset publish",
    "smoke:sequence-renderers": "node scripts/0_sequenceRendererSmoke.mjs",
    "test:sequence-fixtures": "vitest run scripts/1_sequenceFixtures.test.ts",
    "test:sequence-bindings": "vitest run packages/grapht/tests/13_sequenceSvgBindings.test.ts",
    "test:sequence-artifact": "vitest run packages/grapht/tests/14_sequenceArtifact.test.ts",
    "test:sequence-geometry-focus": "vitest run packages/grapht/tests/15_sequenceGeometryFocus.test.ts",
    "test:sequence-board": "vitest run packages/grapht/tests/17_sequenceBoard.test.ts packages/grapht/tests/18_sequenceBoardReceipts.test.ts",
    "test:sequence-identity": "vitest run packages/grapht/tests/12_sequenceIdentity.test.ts",
    "test:sequence-local-documents": "vitest run packages/mmd/src/1_parse.test.ts packages/d2/src/1_parse.test.ts",
    "test:sequence-receipts": "vitest run scripts/2_sequenceRenderReceipts.test.ts",
    "test:sequence-renderers": "vitest run scripts/0_sequenceRendererSmoke.test.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@oxc-parser/binding-wasm32-wasi": "^0.144.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/ui": "^4.1.10",
    "mermaid": "11.16.0",
    "playwright": "1.62.1",
    "publint": "^0.3.23",
    "typedoc": "^0.28.15",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.11"
  }
}
